# Copy to .env and fill in your keys — NEVER commit real keys

# --- Key pool (spec: LLM_API_KEYS takes comma-separated keys in key_1, key_2 order)
LLM_API_KEYS=your_gemini_api_key_here,your_groq_api_key_here

# --- Alternative: set each provider key individually
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- SQLite path — absolute for Docker/Railway, relative for local dev
DATABASE_URL=sqlite:///./data/app.db

# --- CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# --- Failure simulation (set true on deployed backend for demo)
ENABLE_FAILURE_SIMULATION=false
